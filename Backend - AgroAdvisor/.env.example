# API Keys Utama (Wajib diisi atau sistem AI akan gagal)
GEMINI_API_KEY=isi_dengan_api_key_gemini_anda
GROQ_API_KEY=isi_dengan_api_key_groq_anda

# Ollama (Local LLM Fallback)
# Catatan: docker-compose override ke http://ollama:11434 otomatis
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# Konfigurasi Database Docker
# Catatan: docker-compose override DB_HOST ke 'db' otomatis
DB_HOST=db
DB_PORT=3306
DB_NAME=agroadvisor
DB_USER=root
DB_PASSWORD=ganti_dengan_password_database_anda

# Fastapi Host
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=True
FRONTEND_URL=http://rajang.inesa.id
USE_DUMMY_AI=false

# Admin Dashboard Credentials
ADMIN_USERNAME=ganti_dengan_username_admin_anda
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_kuat
ADMIN_TOKEN=ganti_dengan_token_rahasia_yang_panjang_dan_acak

# OpenWeatherMap API
OPENWEATHER_API_KEY=isi_dengan_api_key_openweather_anda
OPENWEATHER_LAT=-6.2
OPENWEATHER_LON=106.8